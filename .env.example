# ---- Data backend -------------------------------------------------------
# "file"     = local JSON database in ./.data (default; great for local dev / preview)
# "supabase" = Supabase Postgres + Auth + Storage (production)
# If left empty, Supabase is used automatically when the three Supabase vars are set.
DATA_BACKEND=

# ---- Supabase (production) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ---- Auth (file backend only) ------------------------------------------
# Long random string used to sign admin session cookies.
AUTH_SECRET=change-me-to-a-long-random-string
# Password for the first admin account created on first run (admin@goodmax.local).
ADMIN_BOOTSTRAP_EMAIL=admin@goodmax.local
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional: automatic translation drafts in Admin ---------------------
# AI drafts (product copy from a photo, translations): either key works; Anthropic wins if both are set.
# Free option: a Gemini key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
